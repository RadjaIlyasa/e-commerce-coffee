generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model cart_items {
  id                 Int              @id @default(autoincrement())
  quantity           Int              @default(1) @db.UnsignedInt
  cart_id            Int
  product_variant_id Int
  carts              carts            @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_carts1")
  product_variants   product_variants @relation(fields: [product_variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_product_variants1")

  @@unique([cart_id, product_variant_id], map: "uq_cart_variant")
  @@index([cart_id], map: "fk_cart_items_carts1_idx")
  @@index([product_variant_id], map: "fk_cart_items_product_variants1_idx")
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique(map: "user_id_UNIQUE")
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_carts_users1")

  @@index([user_id], map: "fk_carts_users1_idx")
}

model categories {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(100)
  slug     String     @unique(map: "slug_UNIQUE") @db.VarChar(45)
  products products[]
}

model order_items {
  id                 Int              @id @default(autoincrement())
  product_name       String           @db.VarChar(225)
  variant_name       String           @db.VarChar(225)
  unit_price         Decimal          @db.Decimal(12, 2)
  quantity           Int              @default(1) @db.UnsignedInt
  order_id           Int
  product_variant_id Int
  orders             orders           @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_orders1")
  product_variants   product_variants @relation(fields: [product_variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_product_variants1")

  @@index([order_id], map: "fk_order_items_orders1_idx")
  @@index([product_variant_id], map: "fk_order_items_product_variants1_idx")
}

model orders {
  id               Int           @id @default(autoincrement())
  status           orders_status @default(pending)
  total_amount     Decimal?      @db.Decimal(12, 2)
  shipping_name    String?       @db.VarChar(225)
  shipping_address String?       @db.VarChar(225)
  shipping_phone   String?       @db.VarChar(20)
  created_at       DateTime?     @default(now()) @db.Timestamp(0)
  user_id          Int
  order_items      order_items[]
  users            users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_users1")

  @@index([user_id], map: "fk_orders_users1_idx")
}

model product_variants {
  id           Int           @id @default(autoincrement())
  sku          String        @unique(map: "sku_UNIQUE") @db.VarChar(105)
  variant_name String        @db.VarChar(225)
  price        Decimal       @db.Decimal(12, 2)
  stock        Int           @db.UnsignedInt
  attributes   String?       @db.LongText
  product_id   Int
  cart_items   cart_items[]
  order_items  order_items[]
  products     products      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_variants_products1")

  @@index([product_id], map: "fk_product_variants_products1_idx")
}

model products {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(225)
  description      String             @db.Text
  image_url        String?            @db.VarChar(225)
  is_active        Boolean?
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  category_id      Int
  product_variants product_variants[]
  categories       categories         @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_categories")

  @@index([category_id], map: "fk_products_categories_idx")
}

model users {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(50)
  email         String    @unique(map: "email_UNIQUE") @db.VarChar(225)
  password_hash String    @db.VarChar(225)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  carts         carts?
  orders        orders[]
}

enum orders_status {
  pending
  paid
  shipped
  completed
  cancelled
}
